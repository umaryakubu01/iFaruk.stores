# ==========================================
# iFaruk.Stores - Environment Configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file to version control.
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ifaruk-stores?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JSON Web Token secret used to sign admin auth tokens
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# First admin account (used only by the one-time seed script)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@ifaruk.stores
ADMIN_PASSWORD=ChangeThisPassword123!

# WhatsApp business number customers will be redirected to (international format, no + or spaces)
# Example: 2348012345678
WHATSAPP_NUMBER=2348000000000

# Allowed origin(s) for CORS - the URL the frontend is served from
CLIENT_ORIGIN=http://localhost:5500

# Cloudinary image storage
# Create these values in your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
